# Runtime uses the restricted role; percent-encode URL password characters.
DATABASE_URL=postgresql+psycopg://trx_app:local-app-only@localhost:5433/trx_dev
DATABASE_LISTENER_URL=postgresql://trx_app:local-app-only@localhost:5433/trx_dev
# Set only in migration commands, never the application service environment.
# DATABASE_ADMIN_URL=postgresql+psycopg://postgres:local-admin-only@localhost:5433/trx_dev
PORT=8080
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
# Transition: DB_URL with ${DB_PASSWORD} or ${PASSWORD} uses DB_PASSWORD explicitly.
# DB_PASSWORD=
