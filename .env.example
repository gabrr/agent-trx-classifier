# Application
PORT=8080
# Cloud Run service URL; Cloud Tasks calls this backend directly.
BACKEND_URL= # https://YOUR_SERVICE.run.app

# Supabase
# For Supabase, use a direct or session-pooler URL with postgres.
DATABASE_URL='postgresql+psycopg://postgres:postgres@localhost:5432/postgres'

# Supabase Auth — project URL and publishable key from the Supabase dashboard.
AUTH_SUPABASE_URL= # https://YOUR_PROJECT.supabase.co
AUTH_SUPABASE_PUBLISHABLE_KEY=

# OpenRouter — API key from OpenRouter.
OPENROUTER_API_KEY=

# TypeSafe — API key from TypeSafe.
TYPESAFE_API_KEY=

# LangSmith — API key from LangSmith.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=trx-classifier
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Google Cloud — project ID, bucket and queue created in your project.
GOOGLE_CLOUD_PROJECT=agent-trx-classifier
GCS_BUCKET=agent-trx-classifier-inputs
TASKS_LOCATION=us-central1
TASKS_QUEUE=trx-processing
# Service accounts for the backend, task delivery and scheduled maintenance.
RUNTIME_EMAIL=trx-runtime@agent-trx-classifier.iam.gserviceaccount.com
TASK_CALLER_EMAIL=trx-task-caller@agent-trx-classifier.iam.gserviceaccount.com
MAINTENANCE_CALLER_EMAIL=trx-maintenance@agent-trx-classifier.iam.gserviceaccount.com
